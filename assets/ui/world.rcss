body { display: block; width: 100%; height: 100%; margin: 0; background-color: transparent; font-family: Noto Sans KR; color: #f4f5eb; font-size: 14dp; }
div { display: block; }
#pause-overlay { display: none; position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-color: #00000099; z-index: 5; justify-content: center; align-items: center; }
body.paused #pause-overlay { display: flex; }
body.paused #crosshair { display: none; }
#pause-panel { width: 380dp; max-width: 80%; padding: 28dp; background-color: #15251df2; border: 1dp #6c865f; }
#settings-title { font-size: 28dp; text-align: center; margin-bottom: 28dp; }
#distance-label { margin-bottom: 16dp; }
#settings-help { color: #bec9b9; font-size: 12dp; line-height: 1.7; margin: 18dp 0 28dp; }
.pause-button { display: block; box-sizing: border-box; width: 100%; padding: 14dp 16dp; margin-top: 12dp; background-color: #344537; border: 1dp #6c865f; color: #eceee4; font-family: Noto Sans KR; font-size: 18dp; text-align: center; cursor: pointer; }
.pause-button:hover, .pause-button:focus { background-color: #4c6244; border-color: #c5d990; }
#distance-controls { display: flex; align-items: center; }
#distance-controls button { display: inline-block; flex-shrink: 0; width: 30dp; height: 28dp; font-family: Noto Sans KR; font-size: 18dp; color: #e5eddd; background-color: #3b5036; text-align: center; cursor: pointer; }
#distance-controls button:hover { background-color: #5c7452; }
#render-distance { display: block; flex-grow: 1; width: 0; height: 28dp; margin: 0 10dp; cursor: pointer; }
#render-distance slidertrack { height: 6dp; margin-top: 11dp; background-color: #53664a; }
#render-distance sliderbar { width: 14dp; height: 26dp; margin-top: 1dp; background-color: #c5d990; }
#render-distance sliderbar:hover { background-color: #e0efb4; }
#render-distance sliderarrowdec, #render-distance sliderarrowinc { width: 0; height: 0; }
#crosshair { position: absolute; left: 50%; top: 50%; width: 20dp; height: 24dp; margin-left: -10dp; margin-top: -12dp; text-align: center; font-size: 20dp; }
#hotbar { position: absolute; bottom: 0; left: 0; width: 100%; display: flex; justify-content: center; }
#block-picker { display: flex; }
.block-slot { position: relative; flex-shrink: 0; width: 88dp; height: 88dp; }
.slot-frame { position: absolute; left: 0; top: 0; width: 88dp; height: 88dp; }
.block-icon { position: absolute; left: 12dp; top: 12dp; width: 64dp; height: 64dp; }
.glow-icon { background-color: #ffffff; }
.slot-selection { display: none; position: absolute; left: 8dp; top: 8dp; width: 72dp; height: 72dp; }
.block-slot.selected .slot-selection { display: block; }
