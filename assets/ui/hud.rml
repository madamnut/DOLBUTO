<rml>
<head>
    <link type="text/rcss" href="style.rcss"/>
</head>
<body>
    <div class="hud-root">
        <div id="chat-panel" class="chat-panel ui-hidden">
            <div id="chat-log" class="chat-log"></div>
            <input type="text" id="chat-input" class="chat-input" value=""/>
        </div>
        <div id="guide-notifications" class="guide-notifications"></div>
        <div id="hp-gauge" class="stat-gauge hp-gauge">
            <img class="stat-gauge-image" src="../textures/ui/player/Gauge.png"/>
            <div id="hp-bar-fill" class="stat-bar-fill hp-bar-fill"></div>
        </div>
        <div id="hunger-gauge" class="stat-gauge hunger-gauge">
            <img class="stat-gauge-image" src="../textures/ui/player/Gauge.png"/>
            <div id="hunger-bar-fill" class="stat-bar-fill hunger-bar-fill"></div>
        </div>
        <div id="thirst-gauge" class="stat-gauge thirst-gauge">
            <img class="stat-gauge-image" src="../textures/ui/player/Gauge.png"/>
            <div id="thirst-bar-fill" class="stat-bar-fill thirst-bar-fill"></div>
        </div>
        <img class="hotbar-image" src="../textures/ui/player/Hotbar.png"/>
        <div id="offhand-items" class="offhand-items"></div>
        <div id="hotbar-items" class="hotbar-items"></div>
        <div id="hotbar-debug-slots" class="hotbar-items"></div>
        <img id="hotbar-scope" class="hotbar-scope hotbar-slot-0" src="../textures/ui/player/Hotbarscope.png"/>
        <div id="radial-menu" class="radial-menu ui-hidden">
            <div class="radial-dead-zone">
                <div id="radial-center-label" class="radial-center-label">Cancel</div>
            </div>
            <div id="radial-actions" class="radial-actions"></div>
            <div id="radial-candidates" class="radial-candidates"></div>
        </div>
    </div>
</body>
</rml>
